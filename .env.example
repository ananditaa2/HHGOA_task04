# ==============================================================================
# TigerDetect Environment Configuration
# ==============================================================================

# Execution Mode: "in_memory" (default for fast offline zero-dep evaluation) or "tigergraph"
GRAPH_BACKEND_MODE=in_memory




# Optional LLM Analyst Narrative (deterministic fallback when disabled)
NARRATIVE_LLM_ENABLED=false
NARRATIVE_LLM_URL=https://api.openai.com/v1/chat/completions
NARRATIVE_LLM_MODEL=gpt-4o-mini

# Application Settings
DEBUG=True
PORT=8501
