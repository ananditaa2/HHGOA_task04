# ==============================================================================
# TigerDetect Environment Configuration
# ==============================================================================

# Execution Mode: "in_memory" (default for fast offline zero-dep evaluation) or "tigergraph"
GRAPH_BACKEND_MODE=in_memory

# TigerGraph Savanna Cloud / Local Connection
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_GRAPH=FraudGraph
TG_SECRET=your_restpp_secret
TG_API_TOKEN=

# LLM / Reasoning Provider (Optional - deterministic rule & graph reasoning works out of the box)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Settings
DEBUG=True
PORT=8501
